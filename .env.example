# Leaflet Environment Configuration Example

# Database Connection (SQLite for local, PostgreSQL URL for production Vercel/Supabase)
DATABASE_URL="file:./leaflet.db"

# JWT Secret Key
JWT_SECRET="your-super-secret-jwt-key"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage Configuration (for PDF uploads in production)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret"
