# Leaflet Environment Configuration Example

# Database Connection (SQLite for local, PostgreSQL URL for production Vercel/Supabase)
DATABASE_URL="file:./leaflet.db"

# JWT Secret Key
JWT_SECRET="your-super-secret-jwt-key"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (Optional - standard S3/Cloudflare R2 for production)
# R2_ACCOUNT_ID="your-r2-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="leaflet-books"
